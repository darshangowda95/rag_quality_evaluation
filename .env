# Lab 2.4 - RAG Evaluation Environment Configuration (Standalone)

# ==============================================================================
# LLM API Configuration (Optional - enables LLM-as-judge metrics)
# ==============================================================================

# OpenRouter API key (get yours at: https://openrouter.ai/keys)
# Without this key, evaluation uses deterministic fallback metrics
OPENROUTER_API_KEY=

# OpenRouter model for LLM-as-judge evaluation
OPENROUTER_MODEL=openai/gpt-4o-mini

# ==============================================================================
# Lab 2.4 Solution Tree Selection
# ==============================================================================

# Which solution tree to use (practice_solution or reference_solution)
RAG_EVAL=practice_solution

# ==============================================================================
# Evaluation Configuration
# ==============================================================================

# Evaluation dataset
EVAL_DATASET_PATH=dataset/evaluation_questions.json
GROUND_TRUTH_PATH=dataset/ground_truth.json
PROMPT_TEMPLATES_PATH=dataset/prompt_templates.json

# Mock RAG service vector store
VECTOR_STORE_PATH=dataset/fixtures/seed_store

# Output directory
REPORTS_DIR=reports

# ==============================================================================
# Mock RAG Service Configuration
# ==============================================================================

DEFAULT_CHUNK_SIZE=512
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.3

# ==============================================================================
# Optimization Configuration
# ==============================================================================

CHUNK_SIZES=256,512,1024
TOP_K_VALUES=3,5,10
TEST_ALL_PROMPTS=true

# ==============================================================================
# Logging
# ==============================================================================

LOG_LEVEL=INFO
